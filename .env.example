# Copy to .env.local and fill in. .env* is gitignored.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Leave empty for local dev: the app falls back to an embedded PGlite
# database stored in ./.pglite, so no Postgres server is needed.
# In production set this to your Neon connection string.
DATABASE_URL=

# Gate the app behind a single shared password. If empty, no auth is enforced
# (fine for localhost, set it before deploying anywhere public).
APP_PASSWORD=

# Signs session cookies. Falls back to APP_PASSWORD when empty, so it is only
# strictly required for Google sign-in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google sign-in. Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this exact
# authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback   (local)
#   https://YOUR-DOMAIN/api/auth/google/callback     (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, comma separated. REQUIRED for Google sign-in: without it any
# Google account on earth could read your spending. An empty list denies everyone.
GOOGLE_ALLOWED_EMAILS=

# Only needed if the deployment URL cannot be derived from request headers;
# it fixes the redirect URI sent to Google. No trailing slash.
AUTH_URL=
