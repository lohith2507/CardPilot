# Copy to .env.local and fill in. .env* is gitignored.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Optional NVIDIA NIM key for merchant JSON extraction (OpenAI-compatible).
# https://build.nvidia.com/
NVIDIA_API_KEY=

# Leave empty for local dev: the app falls back to an embedded PGlite
# database stored in ./.pglite, so no Postgres server is needed.
# In production set this to your Neon connection string.
DATABASE_URL=

# Signs session cookies. When set, the app requires sign-in.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google sign-in (optional). Create a "Web application" OAuth client at
# https://console.cloud.google.com/apis/credentials and add this exact
# authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback   (local)
#   https://YOUR-DOMAIN/api/auth/google/callback     (production)
# Only emails that already exist in the users table can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional extra Google allowlist. Empty = any provisioned user may use Google.
# If set, the address must be both in the users table and in this list.
GOOGLE_ALLOWED_EMAILS=

# Only needed if the deployment URL cannot be derived from request headers;
# it fixes the redirect URI sent to Google. No trailing slash.
AUTH_URL=

# Deprecated: shared APP_PASSWORD gate was replaced by per-user accounts.
# APP_PASSWORD=
